@model IReadOnlyList<WebApplication1.ViewModels.WorkOrderListItemViewModel>
@using WebApplication1.Models.Entities
@{ ViewData["Title"] = "Ремонт и ТО"; }
<div class="page-heading"><div><h1 class="page-title">Ремонт и техническое обслуживание</h1><p class="page-subtitle">План работ, текущие ремонты и назначения механиков.</p></div>@if(User.IsInRole(AppRoles.Administrator)||User.IsInRole(AppRoles.Dispatcher)){<a asp-action="Create" class="btn btn-primary">Создать наряд</a>}</div><div class="panel p-0 overflow-hidden">@if(Model.Count==0){<div class="empty-list"><h2>Работ пока нет</h2><p>Создайте заказ-наряд из заявки или вручную для планового ТО.</p></div>}else{<table class="table mb-0"><thead><tr><th>№</th><th>Работа</th><th>Техника</th><th>Механики</th><th>Статус</th><th>План</th></tr></thead><tbody>@foreach(var item in Model){<tr><td><a asp-action="Details" asp-route-id="@item.Id">@item.Id</a></td><td><a asp-action="Details" asp-route-id="@item.Id">@item.Title</a><small class="d-block text-muted">@(item.Type == WorkOrderType.Repair ? "Ремонт" : "ТО")</small></td><td>@item.Equipment</td><td>@item.Mechanics</td><td><span class="status-pill status-@item.Status.ToString().ToLowerInvariant()">@(item.Status switch {WorkOrderStatus.Planned=>"Запланирован",WorkOrderStatus.InProgress=>"В работе",WorkOrderStatus.WaitingForParts=>"Ожидает детали",WorkOrderStatus.Completed=>"Завершён",WorkOrderStatus.Cancelled=>"Отменён",_=>item.Status.ToString()})</span></td><td>@(item.PlannedStartUtc?.ToLocalTime().ToString("dd.MM HH:mm") ?? "—")<br/><small>@(item.PlannedEndUtc?.ToLocalTime().ToString("dd.MM HH:mm") ?? "срок уточняется")</small></td></tr>}</tbody></table>}</div>
