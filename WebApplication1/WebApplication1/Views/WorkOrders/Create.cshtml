@model WebApplication1.ViewModels.WorkOrderFormViewModel
@using WebApplication1.Models.Entities
@{ ViewData["Title"] = "Новый заказ-наряд"; }
<div class="page-heading"><div><h1 class="page-title">Новый заказ-наряд</h1><p class="page-subtitle">Запланируйте работы и назначьте только свободных механиков.</p></div><a asp-action="Index">К списку работ</a></div>
<div class="panel" style="max-width:900px"><form asp-action="Create" method="post"><input asp-for="RepairRequestId" type="hidden" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-7"><label asp-for="EquipmentId" class="form-label"></label><select asp-for="EquipmentId" asp-items="ViewBag.Equipments" class="form-select"><option value="">Выберите технику</option></select><span asp-validation-for="EquipmentId" class="text-danger"></span></div><div class="col-md-5"><label asp-for="Type" class="form-label">Тип работ</label><select asp-for="Type" class="form-select"><option value="Repair">Ремонт</option><option value="Maintenance">Техническое обслуживание</option></select></div><div class="col-12"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="col-md-6"><label asp-for="PlannedStartLocal" class="form-label"></label><input asp-for="PlannedStartLocal" class="form-control" type="datetime-local" /><span asp-validation-for="PlannedStartLocal" class="text-danger"></span></div><div class="col-md-6"><label asp-for="PlannedEndLocal" class="form-label"></label><input asp-for="PlannedEndLocal" class="form-control" type="datetime-local" /><span asp-validation-for="PlannedEndLocal" class="text-danger"></span></div><div class="col-12"><label asp-for="MechanicIds" class="form-label"></label><select asp-for="MechanicIds" asp-items="ViewBag.Mechanics" class="form-select" multiple size="4"></select><div class="form-text">Удерживайте Ctrl, чтобы выбрать нескольких механиков. Система не сохранит пересекающееся назначение.</div><span asp-validation-for="MechanicIds" class="text-danger"></span></div></div><button class="btn btn-primary mt-4" type="submit">Создать и назначить</button></form></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
