@model WebApplication1.ViewModels.DashboardViewModel
@{ ViewData["Title"] = User.Identity?.IsAuthenticated == true ? "Обзор" : "АгроСервис"; }
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="page-heading"><div><h1 class="page-title">Рабочий обзор</h1><p class="page-subtitle">Сводка по заявкам, ремонту и техническому обслуживанию.</p></div></div>
    <section class="stat-grid" aria-label="Основные показатели"><article><span>Новые заявки</span><strong>@Model.NewRequests</strong><a asp-controller="Requests" asp-action="Index">Открыть очередь</a></article><article><span>Активные работы</span><strong>@Model.ActiveWorkOrders</strong><a asp-controller="WorkOrders" asp-action="Index">Открыть наряды</a></article><article><span>Ожидают детали</span><strong>@Model.WaitingForParts</strong><a asp-controller="Inventory" asp-action="Purchases">Проверить закупки</a></article><article><span>ТО требуется</span><strong>@Model.OverdueMaintenance</strong><a asp-controller="Maintenance" asp-action="Index">Открыть регламенты</a></article></section>
    <div class="row g-4 mt-1"><section class="col-lg-7"><div class="panel"><h2 class="h5">Состояние заказ-нарядов</h2><p class="text-muted small">Количество документов по состояниям. Одинаковый цвет показывает одну числовую шкалу, подписи не зависят от цвета.</p><div class="bar-chart" role="img" aria-label="Количество заказ-нарядов по состояниям">@{var maximum=Math.Max(1,Model.RepairStatusBars.Max(item=>item.Value));}@foreach(var bar in Model.RepairStatusBars){var percent=bar.Value*100/maximum;<div class="bar-row"><span>@bar.Label</span><div class="bar-track"><i style="width:@percent%"></i></div><strong>@bar.Value</strong></div>}</div><details class="chart-table"><summary>Табличное представление</summary><table class="table"><tbody>@foreach(var bar in Model.RepairStatusBars){<tr><th>@bar.Label</th><td>@bar.Value</td></tr>}</tbody></table></details></div></section><aside class="col-lg-5"><div class="panel"><h2 class="h5">Требует внимания</h2>@if(Model.Alerts.Count==0){<p class="text-muted mb-0">Срочных действий нет.</p>}else{<ul class="alert-list">@foreach(var alert in Model.Alerts){<li><a asp-controller="@alert.LinkController" asp-action="@alert.LinkAction"><strong>@alert.Title</strong><span>@alert.Description</span></a></li>}</ul>}</div></aside></div>
}
else
{
<section class="welcome-panel"><div class="welcome-copy"><span class="welcome-kicker">Единая система агропредприятия</span><h1>Техника работает,<br />когда всё под контролем</h1><p>Заявки на неисправности, ремонт и техническое обслуживание — в одном месте. История каждой машины сохраняется и доступна команде.</p><div class="welcome-actions"><a class="btn btn-light" asp-controller="Account" asp-action="Login">Войти в систему</a></div></div><div class="field-illustration" aria-hidden="true"><div class="field-sun"></div><div class="field-hill field-hill-back"></div><div class="field-hill field-hill-front"></div><div class="field-line field-line-one"></div><div class="field-line field-line-two"></div><div class="field-line field-line-three"></div></div></section><section class="overview-section" aria-labelledby="workflow-title"><div class="section-intro"><h2 id="workflow-title">От заявки до готовой техники</h2><p>Каждый участник видит свою часть процесса и актуальный результат.</p></div><div class="workflow-grid"><article><span class="workflow-number">1</span><h3>Сообщить о неисправности</h3><p>Тракторист выбирает машину и описывает проблему прямо в системе.</p></article><article><span class="workflow-number">2</span><h3>Организовать ремонт</h3><p>Диспетчер назначает свободных механиков и следит за сроками.</p></article><article><span class="workflow-number">3</span><h3>Вернуть машину в работу</h3><p>Механик фиксирует выполненные работы, а история остаётся в карточке техники.</p></article></div></section>
}
