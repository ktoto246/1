@model IReadOnlyList<WebApplication1.ViewModels.MaintenanceRuleListItemViewModel>
@{ ViewData["Title"]="Регламенты ТО"; }
<div class="page-heading"><div><h1 class="page-title">Регламенты технического обслуживания</h1><p class="page-subtitle">Напоминания рассчитываются одновременно по календарю и моточасам.</p></div><a asp-action="Create" class="btn btn-primary">Добавить регламент</a></div><div class="panel p-0 overflow-hidden">@if(Model.Count==0){<div class="empty-list"><h2>Регламентов пока нет</h2><p>Задайте интервалы обслуживания для техники.</p></div>}else{<table class="table mb-0"><thead><tr><th>Техника</th><th>Работа</th><th>Следующая дата</th><th>Следующие моточасы</th><th>Состояние</th></tr></thead><tbody>@foreach(var rule in Model){<tr><td>@rule.Equipment</td><td>@rule.Name</td><td>@(rule.NextDateUtc?.ToLocalTime().ToString("dd.MM.yyyy")??"Не задана")</td><td>@(rule.NextHours?.ToString("0.0")??"Не заданы")</td><td><span class="status-pill @(rule.Status=="Требуется"?"status-rejected":rule.Status=="Скоро"?"status-new":"status-completed")">@rule.Status</span></td></tr>}</tbody></table>}</div>
