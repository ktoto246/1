@model WebApplication1.ViewModels.MaintenanceRuleFormViewModel
@{ ViewData["Title"]="Новый регламент ТО"; }
<div class="page-heading"><div><h1 class="page-title">Новый регламент ТО</h1><p class="page-subtitle">Достаточно календарного интервала, моточасов или обоих значений.</p></div><a asp-action="Index">К регламентам</a></div><div class="panel" style="max-width:820px"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-12"><label asp-for="EquipmentId" class="form-label">Техника</label><select asp-for="EquipmentId" asp-items="ViewBag.Equipments" class="form-select"><option value="">Выберите технику</option></select><span asp-validation-for="EquipmentId" class="text-danger"></span></div><div class="col-12"><label asp-for="Name" class="form-label">Наименование работ</label><input asp-for="Name" class="form-control" placeholder="Например, сезонное ТО"/><span asp-validation-for="Name" class="text-danger"></span></div><div class="col-md-6"><label asp-for="IntervalDays" class="form-label">Интервал, дней</label><input asp-for="IntervalDays" class="form-control" type="number" min="1"/><span asp-validation-for="IntervalDays" class="text-danger"></span></div><div class="col-md-6"><label asp-for="IntervalHours" class="form-label">Интервал, моточасов</label><input asp-for="IntervalHours" class="form-control" type="number" step="0.1" min="1"/><span asp-validation-for="IntervalHours" class="text-danger"></span></div><div class="col-md-6"><label asp-for="WarningDays" class="form-label">Предупреждать за дней</label><input asp-for="WarningDays" class="form-control" type="number" min="0"/></div><div class="col-md-6"><label asp-for="WarningHours" class="form-label">Предупреждать за моточасов</label><input asp-for="WarningHours" class="form-control" type="number" step="0.1" min="0"/></div></div><button class="btn btn-primary mt-4">Сохранить регламент</button></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
