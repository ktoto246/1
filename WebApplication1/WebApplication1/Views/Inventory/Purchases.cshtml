@model IReadOnlyList<WebApplication1.Models.Entities.Purchase>
@using WebApplication1.Models.Entities
@{ ViewData["Title"] = "Закупки"; }
<div class="page-heading"><div><h1 class="page-title">Закупки деталей</h1><p class="page-subtitle">Поступления фиксируются только после фактического получения деталей.</p></div><a asp-action="CreatePurchase" class="btn btn-primary">Оформить закупку</a></div><div class="panel p-0 overflow-hidden">@if(Model.Count==0){<div class="empty-list"><h2>Закупок пока нет</h2></div>}else{<table class="table mb-0"><thead><tr><th>№</th><th>Поставщик</th><th>Позиции</th><th>Ожидание</th><th>Статус</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Id</td><td>@item.Supplier.Name</td><td>@string.Join(", ", item.Lines.Select(line=>$"{line.Part.Name}: {line.OrderedQuantity:0.###}"))</td><td>@(item.ExpectedAtUtc?.ToLocalTime().ToString("dd.MM.yyyy")??"—")</td><td>@(item.Status switch {PurchaseStatus.Ordered=>"Заказана",PurchaseStatus.Received=>"Получена",PurchaseStatus.PartiallyReceived=>"Частично получена",PurchaseStatus.Draft=>"Черновик",PurchaseStatus.Cancelled=>"Отменена",_=>item.Status.ToString()})</td><td>@if(item.Status is not PurchaseStatus.Received and not PurchaseStatus.Cancelled){<a asp-action="Receive" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Принять</a>}else if(item.ReceiptStoredFileName is not null){<a asp-controller="Documents" asp-action="Receipt" asp-route-id="@item.Id">Чек PDF</a>}</td></tr>}</tbody></table>}</div>
