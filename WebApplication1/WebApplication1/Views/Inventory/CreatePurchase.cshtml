@model WebApplication1.ViewModels.PurchaseFormViewModel
@{ ViewData["Title"] = "Новая закупка"; }
<div class="page-heading"><div><h1 class="page-title">Оформить закупку</h1><p class="page-subtitle">Заказ оформляется у поставщика вне сайта; здесь сохраняется его учёт.</p></div><a asp-action="Purchases">К закупкам</a></div><div class="panel" style="max-width:720px"><form asp-action="CreatePurchase" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="mb-3"><label asp-for="SupplierId" class="form-label">Поставщик</label><select asp-for="SupplierId" asp-items="ViewBag.Suppliers" class="form-select"><option value="">Выберите поставщика</option></select><span asp-validation-for="SupplierId" class="text-danger"></span></div><div class="mb-3"><label asp-for="PartId" class="form-label">Деталь</label><select asp-for="PartId" asp-items="ViewBag.Parts" class="form-select"><option value="">Выберите деталь</option></select><span asp-validation-for="PartId" class="text-danger"></span></div><div class="row g-3"><div class="col-md-4"><label asp-for="Quantity" class="form-label">Количество</label><input asp-for="Quantity" class="form-control" type="number" step="0.001"/><span asp-validation-for="Quantity" class="text-danger"></span></div><div class="col-md-4"><label asp-for="UnitPrice" class="form-label">Цена за единицу, ₽</label><input asp-for="UnitPrice" class="form-control" type="number" step="0.01"/><span asp-validation-for="UnitPrice" class="text-danger"></span></div><div class="col-md-4"><label asp-for="ExpectedDate" class="form-label"></label><input asp-for="ExpectedDate" class="form-control" type="date"/></div></div><button class="btn btn-primary mt-4">Оформить закупку</button></form></div>
@section Scripts {<partial name="_ValidationScriptsPartial"/>}
