@model WebApplication1.ViewModels.EquipmentFormViewModel
@{ ViewData["Title"] = Model.Id==0?"Новая техника":"Изменить технику"; var creating=Model.Id==0; }
<div class="page-heading"><div><h1 class="page-title">@(creating?"Добавить технику":"Изменить карточку")</h1><p class="page-subtitle">Инвентарный номер уникален и используется во всех документах.</p></div><a asp-action="Index">К списку</a></div><div class="panel" style="max-width:720px"><form asp-action="@(creating?"Create":"Edit")" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="InventoryNumber" class="form-label">Инвентарный номер</label><input asp-for="InventoryNumber" class="form-control"/><span asp-validation-for="InventoryNumber" class="text-danger"></span></div><div class="col-md-6"><label asp-for="RegistrationNumber" class="form-label">Госномер</label><input asp-for="RegistrationNumber" class="form-control"/></div><div class="col-12"><label asp-for="Model" class="form-label">Модель</label><input asp-for="Model" class="form-control"/><span asp-validation-for="Model" class="text-danger"></span></div><div class="col-md-6"><label asp-for="EngineHours" class="form-label">Текущие моточасы</label><input asp-for="EngineHours" class="form-control" type="number" step="0.1" min="0"/><span asp-validation-for="EngineHours" class="text-danger"></span></div></div><button class="btn btn-primary mt-4">@(creating?"Добавить технику":"Сохранить изменения")</button></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
