@model WebApplication1.Models.Entities.Equipment
@using WebApplication1.Models.Entities
@{ ViewData["Title"]=$"Техника {Model.InventoryNumber}"; var history=(IReadOnlyList<WorkOrder>)ViewBag.History; var canManage=User.IsInRole(AppRoles.Administrator)||User.IsInRole(AppRoles.Dispatcher); }
<div class="page-heading"><div><a asp-action="Index">← Техника</a><h1 class="page-title mt-2">@Model.InventoryNumber · @Model.Model</h1><p class="page-subtitle">@(Model.RegistrationNumber??"Госномер не указан") · @Model.EngineHours.ToString("0.0") моточасов</p></div>@if(canManage&&Model.IsActive){<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Изменить</a>}</div><div class="row g-4"><div class="col-lg-7"><section class="panel"><h2 class="h5">История работ</h2>@if(history.Count==0){<p class="text-muted mb-0">Ремонт и ТО ещё не проводились.</p>}else{<ul class="activity-list">@foreach(var order in history){<li><strong>@order.Title</strong><span>@order.CreatedAtUtc.ToLocalTime().ToString("dd.MM.yyyy")</span><p>@order.Status · @(order.Result??order.Description??"Без описания")</p></li>}</ul>}</section></div><aside class="col-lg-5"><section class="panel"><h2 class="h5">Состояние</h2><dl class="detail-list"><div><dt>Активность</dt><dd>@(Model.IsActive?"В эксплуатации":"В архиве")</dd></div><div><dt>Инвентарный номер</dt><dd>@Model.InventoryNumber</dd></div></dl>@if(User.IsInRole(AppRoles.Administrator)&&Model.IsActive){<form asp-action="Archive" asp-route-id="@Model.Id" method="post" class="mt-4"><button class="btn btn-outline-danger">Архивировать технику</button></form>}@if(User.IsInRole(AppRoles.Administrator)&&!Model.IsActive){<form asp-action="Restore" asp-route-id="@Model.Id" method="post" class="mt-4"><button class="btn btn-primary">Восстановить технику</button></form>}</section></aside></div>
