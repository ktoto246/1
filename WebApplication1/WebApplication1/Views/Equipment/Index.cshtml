@model IReadOnlyList<WebApplication1.Models.Entities.Equipment>
@using WebApplication1.Models.Entities
@{ ViewData["Title"]="Техника"; var archived=(bool?)ViewBag.Archived==true; var canManage=User.IsInRole(AppRoles.Administrator)||User.IsInRole(AppRoles.Dispatcher); }
<div class="page-heading"><div><h1 class="page-title">@(archived ? "Архив техники" : "Сельскохозяйственная техника")</h1><p class="page-subtitle">Карточки машин, моточасы и история обслуживания.</p></div><div class="d-flex gap-2">@if(User.IsInRole(AppRoles.Administrator)){<a asp-action="Index" asp-route-archived="@(!archived)" class="btn btn-outline-secondary">@(archived?"Активная техника":"Архив")</a>}@if(canManage){<a asp-action="Create" class="btn btn-primary">Добавить технику</a>}</div></div><div class="panel p-0 overflow-hidden">@if(Model.Count==0){<div class="empty-list"><h2>Техники нет</h2><p>Добавьте первую единицу техники в справочник.</p></div>}else{<table class="table mb-0"><thead><tr><th>Инв. номер</th><th>Модель</th><th>Госномер</th><th>Моточасы</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td><strong>@item.InventoryNumber</strong></td><td>@item.Model</td><td>@(item.RegistrationNumber??"—")</td><td>@item.EngineHours.ToString("0.0") ч</td><td><a asp-action="Details" asp-route-id="@item.Id">Открыть</a></td></tr>}</tbody></table>}</div>
