@model WebApplication1.ViewModels.ReportViewModel
@{ ViewData["Title"]="Отчёты"; var max=Math.Max(1,Model.MechanicLoad.Select(item=>item.Value).DefaultIfEmpty().Max()); }
<div class="page-heading"><div><h1 class="page-title">Отчёт по ремонтам</h1><p class="page-subtitle">Показатели за выбранный период. Закупки и фактический расход отражаются отдельно.</p></div><a asp-action="ExportCsv" asp-route-from="@Model.From.ToString("yyyy-MM-dd")" asp-route-to="@Model.To.ToString("yyyy-MM-dd")" class="btn btn-outline-secondary">Скачать CSV</a></div><form class="panel mb-4" method="get"><div class="row align-items-end g-3"><div class="col-sm-4"><label class="form-label" for="from">С</label><input id="from" name="from" type="date" class="form-control" value="@Model.From.ToString("yyyy-MM-dd")"/></div><div class="col-sm-4"><label class="form-label" for="to">По</label><input id="to" name="to" type="date" class="form-control" value="@Model.To.ToString("yyyy-MM-dd")"/></div><div class="col-sm-4"><button class="btn btn-primary">Построить отчёт</button></div></div></form><section class="stat-grid"><article><span>Ремонтов</span><strong>@Model.Repairs</strong></article><article><span>Завершено</span><strong>@Model.Completed</strong></article><article><span>Просрочено</span><strong>@Model.Overdue</strong></article><article><span>Закупки</span><strong>@Model.PurchasedCost.ToString("N0") ₽</strong></article></section><div class="row g-4 mt-1"><section class="col-lg-7"><div class="panel"><h2 class="h5">Нагрузка механиков</h2>@if(Model.MechanicLoad.Count==0){<p class="text-muted mb-0">В выбранном периоде назначений нет.</p>}else{<div class="bar-chart" role="img" aria-label="Количество назначений механиков">@foreach(var item in Model.MechanicLoad){var percentage=item.Value*100/max;<div class="bar-row"><span>@item.Label</span><div class="bar-track"><i style="width:@percentage%"></i></div><strong>@item.Value</strong></div>}</div><details class="chart-table"><summary>Табличное представление</summary><table class="table"><thead><tr><th>Механик</th><th>Назначений</th></tr></thead><tbody>@foreach(var item in Model.MechanicLoad){<tr><td>@item.Label</td><td>@item.Value</td></tr>}</tbody></table></details>}</div></section><aside class="col-lg-5"><div class="panel"><h2 class="h5">Стоимость деталей</h2><dl class="detail-list"><div><dt>Закуплено</dt><dd>@Model.PurchasedCost.ToString("N2") ₽</dd></div><div><dt>Фактический расход</dt><dd>@Model.UsedCost.ToString("N2") ₽</dd></div><div><dt>Потери и брак</dt><dd>@Model.LossCost.ToString("N2") ₽</dd></div></dl><p class="small text-muted mb-0">Нулевые значения означают, что в периоде ещё не было соответствующих складских движений.</p></div></aside></div>
