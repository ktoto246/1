@model IReadOnlyList<WebApplication1.Models.Entities.Employee>
@using WebApplication1.Models.Entities
@{ ViewData["Title"]="Сотрудники"; var archived=(bool?)ViewBag.Archived==true; var roles=(IReadOnlyDictionary<string,string>)ViewBag.Roles; }
<div class="page-heading"><div><h1 class="page-title">@(archived?"Уволенные сотрудники":"Сотрудники")</h1><p class="page-subtitle">Учётные записи, роли и доступ к системе.</p></div><div class="d-flex gap-2"><a asp-action="Index" asp-route-archived="@(!archived)" class="btn btn-outline-secondary">@(archived?"Активные":"Архив")</a><a asp-action="Create" class="btn btn-primary">Добавить сотрудника</a></div></div><div class="panel p-0 overflow-hidden">@if(Model.Count==0){<div class="empty-list"><h2>Сотрудников нет</h2></div>}else{<table class="table mb-0"><thead><tr><th>ФИО</th><th>Телефон</th><th>Логин</th><th>Роль</th><th>Состояние</th><th></th></tr></thead><tbody>@foreach(var employee in Model){<tr><td>@employee.FullName</td><td>@(employee.Phone??"—")</td><td>@(employee.User?.UserName??"Нет учётной записи")</td><td>@(employee.User is not null&&roles.TryGetValue(employee.User.Id,out var role)?AppRoles.DisplayName(role):"—")</td><td>@(employee.IsActive?"Активен":"Уволен")</td><td>@if(employee.IsActive){<form asp-action="Deactivate" asp-route-id="@employee.Id" method="post"><button class="btn btn-sm btn-outline-danger">Уволить</button></form>}else{<form asp-action="Restore" asp-route-id="@employee.Id" method="post"><button class="btn btn-sm btn-primary">Восстановить</button></form>}</td></tr>}</tbody></table>}</div>
