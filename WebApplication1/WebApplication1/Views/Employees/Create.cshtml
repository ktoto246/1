@model WebApplication1.ViewModels.EmployeeFormViewModel
@using WebApplication1.Models.Entities
@{ ViewData["Title"]="Новый сотрудник"; }
<div class="page-heading"><div><h1 class="page-title">Добавить сотрудника</h1><p class="page-subtitle">Одновременно создаётся персональная учётная запись.</p></div><a asp-action="Index">К сотрудникам</a></div><div class="panel" style="max-width:760px"><form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label asp-for="FullName" class="form-label">ФИО</label><input asp-for="FullName" class="form-control"/><span asp-validation-for="FullName" class="text-danger"></span></div><div class="col-md-4"><label asp-for="Phone" class="form-label">Телефон</label><input asp-for="Phone" class="form-control"/></div><div class="col-md-6"><label asp-for="UserName" class="form-label">Логин</label><input asp-for="UserName" class="form-control"/><span asp-validation-for="UserName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Role" class="form-label">Роль</label><select asp-for="Role" class="form-select"><option value="">Выберите роль</option>@foreach(var role in (string[])ViewBag.Roles){<option value="@role">@AppRoles.DisplayName(role)</option>}</select><span asp-validation-for="Role" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Password" class="form-label">Первичный пароль</label><input asp-for="Password" class="form-control"/><span asp-validation-for="Password" class="text-danger"></span><div class="form-text">Не менее 6 символов, включая цифру и специальный знак.</div></div></div><button class="btn btn-primary mt-4">Создать сотрудника</button></form></div>
@section Scripts{<partial name="_ValidationScriptsPartial"/>}
