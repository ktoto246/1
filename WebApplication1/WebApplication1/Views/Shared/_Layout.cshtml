@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@using WebApplication1.Models.Entities
@inject WebApplication1.Data.ApplicationDbContext Db
@{
    var displayName = "";
    var displayRole = "";
    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        displayName = await Db.Employees.IgnoreQueryFilters().AsNoTracking().Where(employee => employee.User != null && employee.User.Id == userId).Select(employee => employee.FullName).FirstOrDefaultAsync() ?? User.Identity.Name ?? "Пользователь";
        var role = AppRoles.All.FirstOrDefault(User.IsInRole);
        displayRole = role is null ? "" : AppRoles.DisplayName(role);
    }
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — АгроСервис</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg site-nav" aria-label="Основная навигация">
        <div class="container-fluid nav-container">
            <a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-mark" aria-hidden="true">А</span><span>Агро<span>Сервис</span><small>Техника под контролем</small></span></a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Открыть меню"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="main-navigation">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <ul class="navbar-nav main-links me-auto">
                        <li><a asp-controller="Home" asp-action="Index">Обзор</a></li>
                        <li><a asp-controller="Equipment" asp-action="Index">Техника</a></li>
                            @if (User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Dispatcher) || User.IsInRole(AppRoles.TractorDriver))
                            {
                                <li><a asp-controller="Requests" asp-action="Index">Заявки</a></li>
                            }
                        <li><a asp-controller="WorkOrders" asp-action="Index">Ремонт и ТО</a></li>
                        @if (User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Dispatcher))
                        {
                            <li><a asp-controller="Maintenance" asp-action="Index">Регламенты ТО</a></li>
                            <li><a asp-controller="Inventory" asp-action="Index">Детали</a></li>
                        }
                        @if (User.IsInRole(AppRoles.Administrator))
                        {
                            <li><a asp-controller="Employees" asp-action="Index">Сотрудники</a></li>
                            <li><a asp-controller="Reports" asp-action="Index">Отчёты</a></li>
                        }
                    </ul>
                    <div class="user-menu"><span><strong>@displayName</strong><small>@displayRole</small></span><form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="logout">Выйти</button></form></div>
                }
                else
                {
                    <div class="ms-auto"><a class="nav-login" asp-controller="Account" asp-action="Login">Войти в систему</a></div>
                }
            </div>
        </div>
    </nav>
</header>
<main class="page-shell" id="main-content">
    @if (TempData["Success"] is string success) { <div class="alert alert-success" role="status">@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger" role="alert">@error</div> }
    @RenderBody()
</main>
<footer class="site-footer"><div><strong>АгроСервис</strong><span>Учёт обслуживания и ремонта сельхозтехники</span></div><span>Рабочая система агропредприятия</span></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
